# ==========================================
# STYDU4 - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to git!

# ==========================================
# JWT Configuration (REQUIRED)
# ==========================================
# Generate a strong secret key (min 32 characters for HS512)
# Example: openssl rand -base64 32
JWT_SIGNER_KEY=your-secret-key-min-32-characters-long-for-hs512-algorithm

# ==========================================
# Database Configuration (Optional - uses defaults from docker-compose.yml)
# ==========================================
# SPRING_DATASOURCE_USERNAME=stydu4_user
# SPRING_DATASOURCE_PASSWORD=stydu4_pass

# ==========================================
# Google OAuth Configuration (Optional)
# ==========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Email Configuration (Optional)
# ==========================================
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=noreply@stydu4.com
EMAIL_ENABLED=false

# ==========================================
# Stripe Payment Configuration (Optional)
# ==========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# Frontend URL Configuration (Optional)
# ==========================================
APP_FRONTEND_URL=http://localhost:5173
APP_FRONTEND_BASE_URL=http://localhost:8080

# ==========================================
# File Storage Configuration (Optional)
# ==========================================
FILE_STORAGE_LOCATION=/app/storage

# ==========================================
# Java Memory Configuration (Optional)
# ==========================================
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
