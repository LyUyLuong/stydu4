# ============================================================
# Stydu4 deployment env file
# Copy this to `.env` and fill in real values. Never commit .env.
# ============================================================

# --- Domain & Let's Encrypt ---
# The domain you bought (e.g. stydu4.io.vn). DNS A record must point to this VPS's public IP.
APP_DOMAIN=your-domain.example.com
# Email for Let's Encrypt notifications (expiry warnings, etc.)
ACME_EMAIL=you@example.com
# Set STAGING=1 to use Let's Encrypt staging (test) certs while debugging.
# Set to 0 (or remove) for real certs. Real certs have a 5/week rate limit per domain.
STAGING=0

# --- MySQL ---
MYSQL_DATABASE=db_stydu4
MYSQL_USER=stydu4_user
# Generate with:  openssl rand -base64 24
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# --- JWT (Spring Boot) ---
# Must be at least 64 chars for HS512. Generate with:  openssl rand -base64 64
JWT_SIGNER_KEY=change-me-min-64-chars-base64-string-here-please-replace-this-now

# --- Google OAuth (optional, leave dummy if not using Google login) ---
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy

# --- Email / SMTP (optional, leave EMAIL_ENABLED=false if not using) ---
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=noreply@your-domain.example.com
EMAIL_ENABLED=false

# --- Stripe (optional, leave dummy if not using payments) ---
STRIPE_API_KEY=dummy
STRIPE_WEBHOOK_SECRET=dummy
